<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HamMeter</AssemblyName>
    <RootNamespace>HamMeter</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>NennMichSchinken</Authors>
    <Product>HamMeter for Aion 2</Product>
    <ApplicationIcon>..\assets\HamMeter.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Security-sensitive parts (packet filter, recorder) are unit tested directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="HamMeter.Aion2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClickableTransparentOverlay" Version="11.1.0" />
    <!-- HamMeter's own packet reader: LZ4 for "FF FF" bundles, SharpPcap for Npcap capture. -->
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="SharpPcap" Version="6.3.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <!-- Pinned above the transitive versions, which have published security advisories. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <!-- Packet capture, parsing and game data come from Kuroukihime's AIon2-Dps-Meter (GPL-3.0). -->
  <ItemGroup>
    <ProjectReference Include="..\external\AionDpsMeter\AionDpsMeter.Core\AionDpsMeter.Core.csproj" />
    <ProjectReference Include="..\external\AionDpsMeter\AionDpsMeter.Services\AionDpsMeter.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.svg" LogicalName="HamMeter.Icons.%(Filename)%(Extension)" />
    <!-- Monster names and boss flags from A2Tools-DPS-Meter (taengu, GPL-3.0), see Game\Data\SOURCE.md. -->
    <EmbeddedResource Include="Game\Data\npcs.json" LogicalName="HamMeter.Npcs.json" />
    <!-- Patch notes for "What's new" and the key that update signatures are checked against. -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="HamMeter.CHANGELOG.md" />
    <EmbeddedResource Include="Update\release-public-key.txt" LogicalName="HamMeter.ReleasePublicKey" />
    <!-- Bar textures from WispUI (same author, MIT). -->
    <EmbeddedResource Include="Assets\Bars\*.png" LogicalName="HamMeter.Bars.%(Filename)%(Extension)" />
    <None Include="Assets\Icons\LICENSE-lucide.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Official AION 2 class icons (NCSoft), see Assets\Classes\SOURCE.md. -->
    <EmbeddedResource Include="Assets\Classes\*.png" LogicalName="HamMeter.Classes.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
